{
  "manifest_version": 3,
  "name": "Gradescope \u2192 Calendar Sync",
  "version": "1.0.0",
  "description": "Put your Gradescope due dates on Google Calendar. Uses the session you're already signed in to \u2014 no password needed.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gradescope Calendar Sync",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.gradescope.com/*"
  ],
  "oauth2": {
    "client_id": "944722002761-5ide5o37vjr0rrtmlqe1deq6381r68b6.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
    ]
  }
}
