{
  "name": "gradescope-calendar-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Sync Gradescope assignment due dates to Google Calendar. No passwords, no setup.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "zip": "npm run build && cd dist && zip -r ../release.zip . -x '.*'"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "happy-dom": "^15.11.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}